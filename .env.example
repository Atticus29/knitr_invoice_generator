# Environment variables for invoice generator
# Copy this file to .env and replace with your actual values
CALENDAR_ID=your_calendar_id@group.calendar.google.com
FROM_EMAIL=your_email@gmail.com
TO_EMAIL=recipient_email@gmail.com
GMAIL_APP_PASSWORD=your_app_password # Note that this will likely be differnt from your gmail password

# Google OAuth credentials
# Get these from Google Cloud Console
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_PROJECT_ID=your_project_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Toggl Track API credentials
# Get your API token from https://track.toggl.com/profile
TOGGL_API_TOKEN=your_toggl_api_token
TOGGL_WORKSPACE_ID=your_toggl_workspace_id